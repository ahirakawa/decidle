{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" event"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" event"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" event"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" event"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" event"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" hint"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "b=\"$HOME/.local/bin/decidle\"; [ -x \"$b\" ] || exit 0; exec \"$b\" event"
          }
        ]
      }
    ]
  }
}
