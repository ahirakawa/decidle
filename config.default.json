{
  "language": "en",
  "report_dir": ".decidle",
  "report_suffix": ".report.json",
  "conclusion_max_chars": 200,
  "question_max_chars": 40,
  "reply_max_chars": 400,
  "code_extensions": [
    "rs",
    "py",
    "ts",
    "tsx",
    "js",
    "jsx",
    "go",
    "java",
    "kt",
    "swift",
    "c",
    "h",
    "cpp",
    "rb",
    "php",
    "sh",
    "sql"
  ],
  "ignore_path_patterns": [
    "/tmp/",
    "/var/folders/",
    ".claude/",
    ".decidle/"
  ],
  "edit_tools": [
    "Edit",
    "Write",
    "NotebookEdit",
    "apply_patch"
  ],
  "edited_files_threshold": 3,
  "tool_call_threshold": 20,
  "trigger_commands": [
    "maestri ask"
  ],
  "role_dir_marker": "/.maestri/roles/",
  "review_command": "maestri ask",
  "verification_rules": [
    {
      "words": [
        "テスト",
        "test"
      ],
      "commands": [
        "test"
      ]
    },
    {
      "words": [
        "ビルド",
        "build"
      ],
      "commands": [
        "build",
        "cargo check",
        "tsc",
        "make"
      ]
    },
    {
      "words": [
        "push"
      ],
      "commands": [
        "git push"
      ]
    }
  ],
  "max_rounds": 2,
  "agent_prompt_markers": [
    "maestri ask",
    "Terminal #",
    "報告の点検:",
    "Report review:"
  ],
  "portal_command": "",
  "home_port": 7878,
  "clean_after_days": 1,
  "clean_unanswered_after_days": 7
}
